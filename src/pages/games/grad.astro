function onStartGame(){const d=document.getElementById('menu-screen')._getDiff?document.getElementById('menu-screen')._getDiff():2;startNewGame(d);showScreen('game');renderGameScreen();}
function onContinueGame(){if(continueGame()){showScreen('game');renderGameScreen();}else alert('存档读取失败。');}

function formatEffects(ef){return Object.entries(ef).map(([k,v])=>{const c=v>0?'text-green-600 dark:text-green-400':'text-red-600 dark:text-red-400';return`<span class="${c}">${ATTR_NAMES[k]}${v>0?'+':''}${v}</span>`;}).join(' ');}
function renderEventCard(c){const tc={info:'',success:'card-success',warning:'card-warning',danger:'card-danger'}[c.type]||'';return`<div class="event-card ${tc}"><div class="card-title">${c.title}</div><div class="card-desc">${c.description}</div></div>`;}

function renderRoundSummary(result){
  if(!result)return'';
  const attrChanges={};
  if(result.activityResults){result.activityResults.forEach(ar=>{if(ar.effects)for(const[k,v] of Object.entries(ar.effects))attrChanges[k]=(attrChanges[k]||0)+v;});}
  if(result.stageResult&&result.stageResult.result){const ef=result.stageResult.result.effects||{};for(const[k,v] of Object.entries(ef))attrChanges[k]=(attrChanges[k]||0)+v;}
  if(result.randomResult&&result.randomResult.event){const ev=result.randomResult.event;if(ev.effects)for(const[k,v] of Object.entries(ev.effects))attrChanges[k]=(attrChanges[k]||0)+v;if(ev.effectsPositive&&gameState.co>=10)for(const[k,v] of Object.entries(ev.effectsPositive))attrChanges[k]=(attrChanges[k]||0)+v;if(ev.effectsNegative&&gameState.co<10)for(const[k,v] of Object.entries(ev.effectsNegative))attrChanges[k]=(attrChanges[k]||0)+v;}
  let changeHTML='';
  const items=Object.entries(attrChanges).filter(([_,v])=>v!==0).map(([k,v])=>{const cls=v>0?'positive':'negative';return`<span class="change-item ${cls}">${ATTR_NAMES[k]} ${v>0?'+':''}${v}</span>`;}).join('');
  if(items)changeHTML+=`<div class="mb-2"><div class="text-xs font-semibold text-black/50 dark:text-white/50 mb-1.5">📊 能力变化</div><div class="flex flex-wrap gap-1.5">${items}</div></div>`;
  if(result.economyResult){const er=result.economyResult;const cls=er.net>=0?'positive':'negative';changeHTML+=`<div class="mb-2"><div class="text-xs font-semibold text-black/50 dark:text-white/50 mb-1.5">💰 经济结算</div><span class="money-change ${cls}">${er.net>=0?'+':''}¥${er.net}</span> <span class="text-xs text-black/50 dark:text-white/50">（收入¥${er.income} - 支出¥${er.expenses}）</span></div>`;}
  if(result.stageResult&&result.stageResult.result){const sr=result.stageResult.result;const check=sr.check;let checkHTML='';if(check){if(check.type==='random'){checkHTML=`<span class="text-xs text-black/60 dark:text-white/60">🎲 ${check.name}检定：${check.chance}</span>`;}else{const passed=check.have>=check.need;checkHTML=`<span class="text-xs text-black/60 dark:text-white/60">${check.name}检定：需要 ${check.need}，当前 ${check.have} → ${passed?'✅ 成功':'❌ 失败'}</span>`;}}changeHTML+=`<div class="mb-2"><div class="text-xs font-semibold text-black/50 dark:text-white/50 mb-1.5">📋 阶段事件：${result.stageResult.event.name}</div>${checkHTML}</div>`;}
  if(result.randomResult&&result.randomResult.event){const ev=result.randomResult.event;changeHTML+=`<div class="mb-2"><div class="text-xs font-semibold text-black/50 dark:text-white/50 mb-1.5">🎲 突发事件：${ev.name}</div><span class="text-xs text-black/60 dark:text-white/60">${ev.desc}</span></div>`;}
  if(!changeHTML)return'';
  return`<div class="round-summary"><h3 class="text-sm text-black/50 dark:text-white/50 mb-2.5 font-semibold">📋 本回合总览</h3>${changeHTML}</div>`;
}

function renderGameScreen(){
  const st=getStateSummary();if(!st)return;selectedMain=null;selectedSub=null;
  const s=document.getElementById('game-screen');
  s.innerHTML=`
    <div class="game-header"><div class="flex items-center gap-2 flex-wrap"><span class="text-xl">🎓</span><span class="text-lg font-bold text-black dark:text-white">${st.semesterName}</span><span class="text-xs text-black/50 dark:text-white/50">第${st.semester+1}学期 / ${st.totalSemesters}</span></div><div class="flex items-center gap-1"><span class="text-lg">💰</span><span class="text-lg font-extrabold text-[#3b82f6]">${st.money}</span></div></div>
    <div class="attr-bars">${['ac','so','ph','co','ec','re'].map(k=>`<div class="attr-row"><span class="attr-label" style="color:${ATTR_COLORS[k]}">${ATTR_NAMES[k]}</span><div class="attr-bar-bg"><div class="attr-bar-fill" id="bar-${k}" style="width:${st[k]/20*100}%;background:${ATTR_COLORS[k]}"></div></div><span class="attr-value text-black dark:text-white" id="val-${k}">${st[k]}</span></div>`).join('')}</div>
    <div class="mb-3" id="eventCards">${renderRoundSummary(lastRoundResult)}${st.eventCards.map(c=>renderEventCard(c)).join('')}</div>
