function renderActivityGrids(st){
  const acts=getCurrentActivities();
  document.getElementById('mainGrid').innerHTML=acts.map(a=>{const dis=!a.available,rn=dis&&a.reqText?`<span class="text-xs text-red-500 block mt-0.5">需${a.reqText}</span>`:'';return`<div class="activity-card ${dis?'locked':''}" data-id="${a.id}" data-type="main" ${dis?'':`onclick="selectActivity(this,'main')"`}><span class="text-xl block mb-1">${a.icon}</span><span class="text-xs font-bold block">${a.name}</span><div class="text-xs mt-1">${formatEffects(a.effects)}</div>${rn}</div>`;}).join('');
  const sg=document.getElementById('subGrid');
  sg.innerHTML=`<div class="activity-card selected" data-id="none" data-type="sub" onclick="selectActivity(this,'sub')"><span class="text-xl block mb-1">➖</span><span class="text-xs font-bold block">不选</span></div>`+acts.map(a=>{const dis=!a.available;return`<div class="activity-card ${dis?'locked':''}" data-id="${a.id}" data-type="sub" ${dis?'':`onclick="selectActivity(this,'sub')"`}><span class="text-xl block mb-1">${a.icon}</span><span class="text-xs font-bold block">${a.name}</span><div class="text-xs mt-1">${formatEffects(a.effects)}</div></div>`;}).join('');
  selectedSub='none';
}

function selectActivity(el,type){
  const id=el.dataset.id,gid=type==='main'?'#mainGrid':'#subGrid';
  document.querySelectorAll(`${gid} .activity-card`).forEach(c=>c.classList.remove('selected'));
  el.classList.add('selected');
  if(type==='main')selectedMain=id;else selectedSub=id;
  const btn=document.getElementById('btnConfirm');if(btn)btn.disabled=!selectedMain;
}

function onConfirmSemester(){
  if(!selectedMain)return;
  const btn=document.getElementById('btnConfirm');btn.disabled=true;btn.textContent='结算中...';
  const result=advanceSemester(selectedMain,selectedSub);
  if(!result){btn.disabled=false;btn.textContent='确认选择 →';return;}
  lastRoundResult=result;
  setTimeout(()=>{if(result.gameOver){showScreen('ending');renderEndingScreen(result.ending);}else{renderGameScreen();const ec=document.getElementById('eventCards');if(ec)ec.scrollIntoView({behavior:'smooth',block:'start'});}},800);
}

function toggleLog(){const c=document.getElementById('logContent'),a=document.getElementById('logArrow');if(c.classList.contains('hidden')){c.classList.remove('hidden');a.textContent='▼';c.scrollTop=c.scrollHeight;}else{c.classList.add('hidden');a.textContent='▶';}}

function renderEndingScreen(ending){
  const s=document.getElementById('ending-screen'),st=gameState;if(!ending)ending=ENDINGS[st.ending]||ENDINGS.graduate;
  const ts={good:{border:'#27ae60',bg:'rgba(39,174,96,0.08)',badge:'🏆 好结局'},mid:{border:'#f39c12',bg:'rgba(243,156,18,0.08)',badge:'😐 中等结局'},bad:{border:'#e74c3c',bg:'rgba(231,76,60,0.08)',badge:'💀 坏结局'}}[ending.type]||{border:'#f39c12',bg:'rgba(243,156,18,0.08)',badge:'😐 中等结局'};
  s.innerHTML=`<div class="max-w-xl mx-auto"><div class="ending-card" style="border-top:4px solid ${ts.border};background:${ts.bg};">
    <div class="text-xs font-bold text-black/50 dark:text-white/50 mb-2.5">${ts.badge}</div><div class="ending-icon">${ending.icon||'🎓'}</div>
    <h1 class="ending-name text-black dark:text-white">「${ending.name}」</h1><p class="ending-desc text-black/80 dark:text-white/80">${ending.desc}</p>
    <div class="bg-black/5 dark:bg-white/5 rounded-lg p-4 mb-4"><h3 class="text-xs text-black/50 dark:text-white/50 mb-2.5 font-semibold">最终属性</h3><div class="grid grid-cols-3 gap-2">${['学术','社交','身体','编程','经济','心理'].map((n,i)=>{const k=['ac','so','ph','co','ec','re'][i];return`<div class="text-center"><span class="text-xs text-black/50 dark:text-white/50 block">${n}</span><span class="text-lg font-extrabold text-black dark:text-white">${st[k]}</span></div>`;}).join('')}</div><div class="text-sm text-black/50 dark:text-white/50 mt-2.5 text-center">余额：¥${st.money}</div><div class="text-sm text-black/50 dark:text-white/50 text-center">共经历了 ${st.semester} 个学期</div></div>
    <div class="mb-5"><h3 class="text-xs text-black/50 dark:text-white/50 mb-2 font-semibold">游戏日志</h3><div class="max-h-44 overflow-y-auto bg-black/5 dark:bg-white/5 rounded-lg p-3">${st.log.slice(-20).map(l=>`<div class="log-line">${l.text}</div>`).join('')}</div></div>
    <div class="flex gap-2.5 justify-center flex-wrap"><button class="btn-action" onclick="onRestartGame()">再来一次</button><button class="btn-action btn-secondary" onclick="window.location.href='/games'">返回百宝箱</button></div>
  </div></div>`;
}
function onRestartGame(){deleteSave();showScreen('menu');renderMenuScreen();}

// 初始化
(function init(){
  renderMenuScreen();
})();
</script>
