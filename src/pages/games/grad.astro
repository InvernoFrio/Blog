const ATTR_COLORS={ac:'#3498db',so:'#e67e22',ph:'#2ecc71',co:'#9b59b6',ec:'#f1c40f',re:'#e74c3c'};
const ATTR_NAMES={ac:'学术',so:'社交',ph:'身体',co:'编程',ec:'经济',re:'心理'};
let selectedMain=null,selectedSub=null,lastRoundResult=null;

function showScreen(n){
  document.getElementById('menu-screen').classList.toggle('hidden',n!=='menu');
  document.getElementById('game-screen').classList.toggle('hidden',n!=='game');
  document.getElementById('ending-screen').classList.toggle('hidden',n!=='ending');
