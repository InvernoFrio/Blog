      ${Object.entries(DIFFICULTIES).map(([k,d])=>`<div class="diff-card ${k==2?'selected':''}" data-diff="${k}"><span class="diff-icon">${d.icon}</span><span class="diff-name">${d.name}</span><span class="diff-desc">${d.desc}</span></div>`).join('')}
    </div></div>
