---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
---

<MainGridLayout title="读个研先" description="从大一到研二，你的每个选择都是命运">
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative">
    <div class="card-base z-10 relative w-full min-h-[60vh]">

      <!-- 菜单界面 -->
      <div id="menu-screen"></div>

      <!-- 游戏界面 -->
      <div id="game-screen" class="hidden px-4 sm:px-6 py-6"></div>

      <!-- 结局界面 -->
      <div id="ending-screen" class="hidden px-4 sm:px-6 py-6"></div>

    </div>
  </div>
</MainGridLayout>

<style>
  /* 菜单覆盖层 */
  :global(.menu-cover) {
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #2b6cb0 0%, #1a1a2e 100%);
    color: #fff;
    padding: 20px;
    border-radius: var(--radius-large);
  }
  :global(.menu-content) { max-width: 720px; text-align: center; width: 100%; }
  :global(.menu-title) { font-size: 2.5rem; font-weight: 700; margin-bottom: 8px; text-shadow: 0 2px 8px rgba(0,0,0,0.3); }
  :global(.menu-subtitle) { font-size: 1rem; color: rgba(255,255,255,0.8); margin-bottom: 28px; }
  :global(.diff-grid) { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  :global(.diff-card) {
    background: rgba(255,255,255,0.06); border: 2px solid rgba(255,255,255,0.12);
    border-radius: 8px; padding: 14px; cursor: pointer; transition: all 0.2s; text-align: center;
  }
  :global(.diff-card:hover) { border-color: rgba(255,255,255,0.3); background: rgba(255,255,255,0.1); }
  :global(.diff-card.selected) { border-color: #38a169; background: rgba(56,161,105,0.2); }
  :global(.diff-icon) { font-size: 1.4rem; display: block; margin-bottom: 4px; }
  :global(.diff-name) { font-weight: 700; font-size: 0.95rem; display: block; }
  :global(.diff-desc) { font-size: 0.75rem; color: rgba(255,255,255,0.5); display: block; margin-top: 2px; }
  :global(.menu-actions) { margin-top: 12px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  /* 按钮 */
  :global(.btn-start) {
    padding: 10px 28px; border-radius: 6px; font-size: 1rem;
    font-weight: 700; cursor: pointer; border: none; background: #38a169; color: #fff; transition: all 0.2s;
  }
  :global(.btn-start:hover) { background: #2f855a; }
  :global(.btn-continue) {
    padding: 10px 28px; border-radius: 6px; font-size: 1rem;
    font-weight: 700; cursor: pointer; border: 2px solid rgba(255,255,255,0.25); background: transparent; color: #fff; transition: all 0.2s;
  }
  :global(.btn-continue:hover) { border-color: rgba(255,255,255,0.5); }

  /* 打字机光标 */
  :global(.typing-cursor) {
    display: inline-block; width: 3px; height: 1em; background: #fff;
    margin-left: 4px; animation: blink 1s infinite; vertical-align: text-bottom;
  }
  @keyframes blink { 0%,50%{opacity:1} 51%,100%{opacity:0} }

  /* 游戏头部 */
  :global(.game-header) {
    background: rgba(0,0,0,0.03); border-radius: 8px;
    padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px;
  }
  :global(.dark) :global(.game-header) { background: rgba(255,255,255,0.05); }

  /* 属性条 */
  :global(.attr-bars) {
    display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;
    background: rgba(0,0,0,0.03); border-radius: 8px; padding: 12px; margin-bottom: 12px;
  }
  :global(.dark) :global(.attr-bars) { background: rgba(255,255,255,0.05); }
  :global(.attr-row) { display: flex; align-items: center; gap: 6px; }
  :global(.attr-label) { font-size: 0.78rem; font-weight: 700; width: 28px; text-align: right; flex-shrink: 0; }
  :global(.attr-bar-bg) { flex: 1; height: 8px; background: rgba(0,0,0,0.08); border-radius: 4px; overflow: hidden; }
  :global(.dark) :global(.attr-bar-bg) { background: rgba(255,255,255,0.1); }
  :global(.attr-bar-fill) { height: 100%; border-radius: 4px; transition: width 0.5s ease; }
  :global(.attr-value) { font-size: 0.85rem; font-weight: 800; width: 22px; text-align: center; }

  /* 事件卡片 */
  :global(.event-card) {
    border: 2px solid #3b82f6; border-radius: 8px;
    padding: 10px 12px; background: rgba(0,0,0,0.02); margin-bottom: 8px; transition: all 0.3s ease;
  }
  :global(.dark) :global(.event-card) { background: rgba(255,255,255,0.03); }
  :global(.card-success) { border-color: #38a169; }
  :global(.card-warning) { border-color: #d97706; }
  :global(.card-danger) { border-color: #e53e3e; }
  :global(.card-title) { font-weight: 700; font-size: 0.9rem; margin-bottom: 4px; }
  :global(.card-desc) { font-size: 0.82rem; color: rgba(0,0,0,0.6); line-height: 1.5; }
  :global(.dark) :global(.card-desc) { color: rgba(255,255,255,0.6); }

  /* 活动选择 */
  :global(.activity-grid) { display: flex; flex-wrap: nowrap; gap: 8px; margin-bottom: 14px; overflow-x: auto; padding-bottom: 4px; }
  :global(.activity-card) {
    min-width: 110px; flex: 0 0 auto; background: rgba(0,0,0,0.03); border: 1px solid rgba(0,0,0,0.1);
    border-radius: 8px; padding: 10px 8px; text-align: center; cursor: pointer; transition: all 0.15s;
  }
  :global(.dark) :global(.activity-card) { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); }
  :global(.activity-card:hover:not(.locked)) { border-color: #3b82f6; transform: translateY(-1px); }
  :global(.activity-card.selected) { border-color: #3b82f6; border-width: 2px; background: rgba(59,130,246,0.08); }
  :global(.activity-card.locked) { opacity: 0.35; cursor: not-allowed; }

  /* 确认按钮 */
  :global(.btn-confirm) {
    padding: 10px 40px; border-radius: 6px; font-size: 1rem;
    font-weight: 700; cursor: pointer; border: none; background: #3b82f6; color: #fff; transition: all 0.15s;
  }
  :global(.btn-confirm:hover:not(:disabled)) { filter: brightness(1.1); }
  :global(.btn-confirm:disabled) { opacity: 0.4; cursor: not-allowed; }

  /* 回合总览 */
  :global(.round-summary) {
    background: rgba(0,0,0,0.02); border-radius: 8px; padding: 12px; margin-bottom: 10px;
    border-left: 3px solid #3b82f6;
  }
  :global(.dark) :global(.round-summary) { background: rgba(255,255,255,0.03); }
  :global(.change-item) { display: inline-flex; align-items: center; gap: 3px; padding: 2px 8px; border-radius: 4px; font-size: 0.78rem; font-weight: 700; }
  :global(.change-item.positive) { background: rgba(56,161,105,0.12); color: #38a169; }
  :global(.change-item.negative) { background: rgba(229,62,62,0.12); color: #e53e3e; }
  :global(.money-change) { font-size: 0.9rem; font-weight: 800; }
  :global(.money-change.positive) { color: #38a169; }
  :global(.money-change.negative) { color: #e53e3e; }

  /* 日志 */
  :global(.log-content) { max-height: 260px; overflow-y: auto; }
  :global(.log-line) { font-size: 0.78rem; color: rgba(0,0,0,0.5); padding: 3px 0; border-bottom: 1px solid rgba(0,0,0,0.03); }
  :global(.dark) :global(.log-line) { color: rgba(255,255,255,0.5); border-bottom-color: rgba(255,255,255,0.03); }

  /* 结局 */
  :global(.ending-card) { border-radius: 8px; padding: 28px 24px; }
  :global(.ending-icon) { font-size: 2.5rem; margin-bottom: 10px; }
  :global(.ending-name) { font-size: 1.6rem; font-weight: 700; margin-bottom: 14px; }
  :global(.ending-desc) { font-size: 0.95rem; line-height: 1.8; margin-bottom: 20px; }
  :global(.btn-action) {
    padding: 8px 24px; border-radius: 6px; font-size: 0.9rem;
    font-weight: 700; cursor: pointer; border: none; background: #3b82f6; color: #fff; transition: all 0.15s;
  }
  :global(.btn-action:hover) { filter: brightness(1.1); }
  :global(.btn-action.btn-secondary) { background: transparent; border: 1px solid rgba(0,0,0,0.15); color: inherit; }
  :global(.dark) :global(.btn-action.btn-secondary) { border-color: rgba(255,255,255,0.2); }

  @media (max-width: 640px) {
    :global(.diff-grid) { grid-template-columns: 1fr; }
    :global(.menu-title) { font-size: 2rem; }
    :global(.attr-bars) { grid-template-columns: 1fr; }
    :global(.game-header) { flex-direction: column; align-items: flex-start; gap: 6px; }
  }
</style>

<script>
// ============================================================
// 「读个研先」数据层
// ============================================================
const SEMESTER_NAMES = ['大一上','大一下','大二上','大二下','大三上','大三下','大四上','大四下','研一上','研一下','研二上','研二下'];
function getPhase(s) { return s < 4 ? 0 : s < 8 ? 1 : 2; }

const DIFFICULTIES = {
  1: { name:'养老模式', icon:'🌸', moneyMult:2.0, eventChance:0.10, badEnding:false, desc:'资金×2，无BE，纯看剧情' },
  2: { name:'普通模式', icon:'📖', moneyMult:1.0, eventChance:0.30, badEnding:true, desc:'标准体验，有压力' },
  3: { name:'地狱模式', icon:'🔥', moneyMult:0.7, eventChance:0.50, badEnding:true, desc:'资金×0.7，事件残酷' },
  4: { name:'随机模式', icon:'🎲', moneyMult:1.0, eventChance:0.30, badEnding:true, desc:'活动由系统随机分配' },
};

const ACTIVITIES = [
  {id:'gpa',      name:'卷绩点',  icon:'📚', phase:[0],   effects:{ac:3,so:1}, req:null},
  {id:'club',     name:'进社团',  icon:'🎭', phase:[0],   effects:{so:3,co:1}, req:null},
  {id:'contest0', name:'竞赛入门',icon:'🏆', phase:[0],   effects:{co:3,ac:1}, req:null},
  {id:'social0',  name:'社会实践',icon:'🤝', phase:[0],   effects:{so:2,ec:2}, req:null},
  {id:'gym0',     name:'健身运动',icon:'💪', phase:[0],   effects:{ph:3,re:1}, req:null},
  {id:'chill0',   name:'躺平摆烂',icon:'😴', phase:[0],   effects:{re:2,ph:-1},req:null},
  {id:'contest1', name:'冲刺竞赛',icon:'⚔️', phase:[1],   effects:{co:4,ac:3,re:1}, req:{co:5}},
  {id:'research1',name:'进组科研',icon:'🔬', phase:[1],   effects:{ac:5,re:2}, req:{ac:6}},
  {id:'gpa1',     name:'卷绩点',  icon:'📚', phase:[1],   effects:{ac:2,so:2}, req:null},
  {id:'parttime', name:'兼职赚钱',icon:'💰', phase:[1],   effects:{ec:4,so:2}, req:{so:3}},
  {id:'intern',   name:'实习',    icon:'💼', phase:[1],   effects:{ec:3,so:3,co:1}, req:{so:5,co:4}},
  {id:'gym1',     name:'健身运动',icon:'💪', phase:[1],   effects:{ph:3,re:2}, req:null},
  {id:'chill1',   name:'躺平摆烂',icon:'😴', phase:[1],   effects:{re:3,ac:-2},req:null},
  {id:'research2',name:'深度科研',icon:'🧪', phase:[2],   effects:{ac:6,re:3}, req:{ac:10}},
  {id:'contest2', name:'高级竞赛',icon:'🏅', phase:[2],   effects:{co:5,ac:4}, req:{co:8}},
  {id:'jobhunt',  name:'找工作',  icon:'🔍', phase:[2],   effects:{ec:5,so:3}, req:{so:6,co:5}},
  {id:'intern2',  name:'全职实习',icon:'🏢', phase:[2],   effects:{ec:6,so:2}, req:{so:7}},
  {id:'gym2',     name:'健身运动',icon:'💪', phase:[2],   effects:{ph:4,re:2}, req:null},
  {id:'chill2',   name:'躺平摆烂',icon:'😴', phase:[2],   effects:{re:4,ac:-3},req:null},
];
function getAvailableActivities(phase) { return ACTIVITIES.filter(a=>a.phase.includes(phase)); }
function canDoActivity(a,st) {
  if(!a.req) return true;
  for(const[k,v] of Object.entries(a.req)) if((st[k]||0)<v) return false;
  return true;
}

const ECONOMY={tuition:3000,baseLiving:1500,livingPhBonus:100,parents:2000,scholarshipBase:1500,scholarshipMax:5000,contestFee:200,materialFee:500,parttimeIncome:[800,2000],internIncome:[3000,8000],researchStipend:[500,1500]};
function calcExpenses(st){
  let t=ECONOMY.tuition;
  t+=ECONOMY.baseLiving+ECONOMY.baseLiving-Math.min(500,(st.ph||1)*ECONOMY.livingPhBonus);
  t+=Math.min(1000,(st.so||1)*60);
  return t;
}
function calcIncome(st,main){
  let t=ECONOMY.parents*DIFFICULTIES[st.difficulty].moneyMult;
  if(st.ac>=8&&st.so>=5){t+=Math.min(ECONOMY.scholarshipMax,ECONOMY.scholarshipBase+Math.floor((st.ac-8)*500));}
  if(main==='parttime')t+=randRange(...ECONOMY.parttimeIncome);
  if(main==='intern'||main==='intern2')t+=randRange(...ECONOMY.internIncome);
  if((main==='research1'||main==='research2')&&st.ac>=8)t+=randRange(...ECONOMY.researchStipend);
  if(main.startsWith('contest'))t-=ECONOMY.contestFee;
  if(main==='gpa'||main==='gpa1'||main.startsWith('research'))t-=randRange(0,ECONOMY.materialFee);
  return Math.floor(t);
}

const STAGE_EVENTS=[
  {id:'final_exam',name:'期末考试',type:'common',trigger:()=>true,resolve(st){return st.ac>=5?{success:true,desc:'期末考试顺利通过！',effects:{ac:2},check:{attr:'ac',need:5,have:st.ac,name:'学术'}}:{success:false,desc:'期末考试翻车了……',effects:{ac:-1,re:-1},check:{attr:'ac',need:5,have:st.ac,name:'学术'}};}},
  {id:'midterm',name:'期中突击',type:'common',trigger:()=>true,resolve(){return Math.random()<0.5?{success:true,desc:'期中突击成功！AC+1',effects:{ac:1},check:{type:'random',name:'运气',chance:'50%'}}:{success:false,desc:'期中突击失败。',effects:{ac:-1},check:{type:'random',name:'运气',chance:'50%'}};}},
  {id:'group_meeting',name:'组会汇报',type:'research',trigger:(st,m)=>m.startsWith('research'),resolve(st){const total=st.ac+st.so;if(total>=12)return{success:true,desc:'组会汇报不错，导师点头了。',effects:{ac:3,so:1},check:{attr:'ac+so',need:12,have:total,name:'学术+社交'}};st.fail_count=(st.fail_count||0)+1;let d='组会汇报翻车了……';if(st.fail_count>=3)d+='（第'+st.fail_count+'次了……）';return{success:false,desc:d,effects:{so:-2},check:{attr:'ac+so',need:12,have:total,name:'学术+社交'}};}},
  {id:'school_contest',name:'校赛突围',type:'contest',trigger:(st,m)=>m.startsWith('contest'),resolve(st){if(st.co>=6){(st.events_completed=st.events_completed||[]).push('school_contest');return{success:true,desc:'校赛突围成功！¥500奖金。',effects:{co:2},reward:500,check:{attr:'co',need:6,have:st.co,name:'编程'}};}return{success:false,desc:'校赛遗憾出局。',effects:{re:-2},check:{attr:'co',need:6,have:st.co,name:'编程'}};}},
  {id:'province_contest',name:'省赛冲刺',type:'contest',trigger:(st,m)=>m.startsWith('contest')&&st.events_completed?.includes('school_contest')&&st.co>=10,resolve(st){if(st.co>=12){st.events_completed.push('province_contest');return{success:true,desc:'省赛二等奖！¥2000！',effects:{co:4,so:2},reward:2000,check:{attr:'co',need:12,have:st.co,name:'编程'}};}return{success:false,desc:'省赛败北。',effects:{re:-3},check:{attr:'co',need:12,have:st.co,name:'编程'}};}},
  {id:'national_contest',name:'国赛决战',type:'contest',trigger:(st,m)=>m.startsWith('contest')&&st.events_completed?.includes('province_contest')&&st.co>=14,resolve(st){if(st.co>=16){st.events_completed.push('national_contest');return{success:true,desc:'国一！¥5000！CO+6！',effects:{co:6},reward:5000,check:{attr:'co',need:16,have:st.co,name:'编程'}};}return{success:false,desc:'国赛止步。',effects:{re:-4},check:{attr:'co',need:16,have:st.co,name:'编程'}};}},
  {id:'literature_report',name:'文献汇报',type:'research',trigger:(st,m)=>m.startsWith('research'),resolve(st){return st.ac>=8?{success:true,desc:'文献汇报顺利。',effects:{ac:3,so:1},check:{attr:'ac',need:8,have:st.ac,name:'学术'}}:{success:false,desc:'文献汇报翻车。',effects:{so:-2},check:{attr:'ac',need:8,have:st.ac,name:'学术'}};}},
  {id:'paper_rejected',name:'论文被拒',type:'research',trigger:(st,m)=>m.startsWith('research')&&st.ac>=12&&st.events_completed?.includes('literature_report'),resolve(){return Math.random()<0.4?{success:false,desc:'论文被拒了……',effects:{re:-4,ac:-2},check:{type:'random',name:'运气',chance:'40%被拒'}}:{success:true,desc:'审稿人大修，还有机会！',effects:{},check:{type:'random',name:'运气',chance:'40%被拒'}};}},
  {id:'paper_accepted',name:'论文接收',type:'research',trigger:(st,m)=>m.startsWith('research')&&st.ac>=14,resolve(){return Math.random()<0.6?{success:true,desc:'论文被接收了！！AC+6, SO+4！',effects:{ac:6,so:4},paperAccepted:true,check:{type:'random',name:'运气',chance:'60%接收'}}:{success:false,desc:'论文最终被拒。',effects:{re:-3},check:{type:'random',name:'运气',chance:'60%接收'}};}},
];
function pickStageEvent(st,main){
  const av=STAGE_EVENTS.filter(e=>e.trigger(st,main));if(!av.length)return null;
  const chain=av.filter(e=>e.type!=='common'),common=av.filter(e=>e.type==='common');
  if(chain.length&&Math.random()<0.6)return chain[Math.floor(Math.random()*chain.length)];
  return common[Math.floor(Math.random()*common.length)]||chain[0];
}

const RANDOM_EVENTS=[
  {id:'code_works',name:'代码跑通了',type:'positive',weight:10,desc:'代码一次就跑通了！',effects:{co:3,re:2}},
  {id:'advisor_praise',name:'被导师夸了',type:'positive',weight:7,desc:'导师难得夸了你一句。',effects:{re:4,ac:2}},
  {id:'senior_help',name:'被师兄/师姐带飞',type:'positive',weight:8,desc:'师兄/师姐分享了科研经验。',effects:{ac:3,so:2}},
  {id:'free_lecture',name:'蹭到大佬报告',type:'positive',weight:6,desc:'蹭了一场学术报告。',effects:{ac:4}},
  {id:'secondhand',name:'二手群捡漏',type:'positive',weight:5,desc:'低价淘到了好东西。',effects:{ec:2}},
  {id:'inspiration',name:'论文灵感',type:'positive',weight:7,desc:'洗澡时有了灵感！AC+5！',effects:{ac:5}},
  {id:'keyboard_ace',name:'键盘侠觉醒',type:'positive',weight:8,desc:'顿悟了编程本质！CO+4！',effects:{co:4}},
  {id:'new_dish',name:'食堂出新菜',type:'positive',weight:5,desc:'好吃但贵了点。',effects:{ph:2,ec:-1}},
  {id:'bonus_income',name:'意外收入',type:'positive',weight:8,desc:'意外之财！¥1000！',effects:{},reward:1000},
  {id:'advisor_push',name:'导师push',type:'neutral',weight:15,desc:'导师安排了一堆任务……',effects:{re:-3,ac:1}},
  {id:'stood_up',name:'被鸽了',type:'neutral',weight:10,desc:'合作泡汤了。',effects:{so:-3,re:-2}},
  {id:'fail_warning',name:'挂科警告',type:'neutral',weight:12,desc:'收到了挂科警告……',cond:s=>s.ac<8,effects:{ac:-3,re:-4}},
  {id:'got_partner',name:'脱单了',type:'neutral',weight:5,desc:'你脱单了！钱包缩水了。',effects:{re:4,ec:-2}},
  {id:'broke_up',name:'分手了',type:'neutral',weight:5,desc:'分手了……化悲痛为力量。',effects:{re:-5,ph:-2},bonusNext:1.5},
  {id:'allnighter',name:'通宵赶ddl',type:'neutral',weight:12,desc:'ddl是第一生产力。',effects:{ph:-3,ac:1}},
  {id:'pc_broken',name:'电脑坏了',type:'neutral',weight:10,desc:'维修花了¥2000。',effects:{},cost:2000},
  {id:'sick',name:'生病住院',type:'neutral',weight:15,desc:'住院花了¥1500。',cond:s=>s.ph<6,effects:{ph:-3,re:-2},cost:1500},
  {id:'power_outage',name:'宿舍停水停电',type:'neutral',weight:8,desc:'人间疾苦。',effects:{re:-2,ph:-1}},
  {id:'ai_threat',name:'AI抢饭碗',type:'neutral',weight:8,desc:'AI又进化了。',cond:s=>s.co>=10,effectsPositive:{co:3},effectsNegative:{re:-3}},
  {id:'code_fails',name:'代码跑不通',type:'neutral',weight:10,desc:'debug了一整天。',effects:{co:-1,re:-3}},
  {id:'overwork_death',name:'熬夜猝死风险',type:'lethal',weight:10,desc:'心脏发出了警告……',cond:s=>s.ph<5,ending:'overwork'},
  {id:'mental_breakdown',name:'精神崩溃',type:'lethal',weight:10,desc:'精神到了崩溃边缘。',cond:s=>s.re<4,ending:'mental'},
];
function rollRandomEvent(st){
  const d=DIFFICULTIES[st.difficulty];if(Math.random()>d.eventChance)return null;
  let pool=d.badEnding?RANDOM_EVENTS:RANDOM_EVENTS.filter(e=>e.type==='positive');
  pool=pool.filter(e=>!e.cond||e.cond(st));if(!pool.length)return null;
  const tw=pool.reduce((s,e)=>s+e.weight,0);let r=Math.random()*tw;
  for(const e of pool){r-=e.weight;if(r<=0)return e;}return pool[pool.length-1];
}

const ENDINGS={
  academic_star:{name:'学术新星',icon:'⭐',type:'good',desc:'你在研二发出了人生第一篇顶刊，导师激动得请全组吃了顿海底捞。你拿到了直博offer，前途一片光明。'},
  national_award:{name:'国奖大佬',icon:'🏅',type:'good',desc:'国奖拿到手软，大厂抢着要。"国家奖学金"是最闪亮的一行。'},
  hexagon:{name:'六边形战士',icon:'💪',type:'good',desc:'学术、社交、身体、编程、经济、心理全面发展，你是真正的人生赢家。'},
  graduate:{name:'顺利毕业',icon:'🎓',type:'good',desc:'读了个研，没死，挺好的。虽然没什么惊天动地的成就，但你活下来了。'},
  civil_servant:{name:'考公上岸',icon:'📋',type:'mid',desc:'宇宙的尽头是编制。你成功上岸，从此过上了朝九晚五的幸福生活。'},
  abroad:{name:'润了',icon:'✈️',type:'mid',desc:'再见了妈妈今晚我就要远航。你拿到了海外offer。'},
  inherit:{name:'继承家业',icon:'🏠',type:'mid',desc:'我也不想的，但是它给的太多了。'},
  overwork:{name:'英年早逝',icon:'💀',type:'bad',desc:'熬夜熬没了，享年22岁。你还保持着写代码的姿势。'},
  mental:{name:'退学跑路',icon:'🚪',type:'bad',desc:'这个研我不读了！你头也不回地离开了校园。'},
  delayed:{name:'延毕大师',icon:'📅',type:'bad',desc:'再给我一年，我一定能毕业。（并不会）'},
  bankrupt:{name:'破产跑路',icon:'💸',type:'bad',desc:'学费交不起了，回家种地。'},
  advisor_kick:{name:'导师劝退',icon:'👋',type:'bad',desc:'"你可能不适合科研。"温柔的刀。'},
};
function checkBadEnding(st){
  if(!DIFFICULTIES[st.difficulty].badEnding)return null;
  if(st.money<=0)return ENDINGS.bankrupt;
  if(st.fail_count>=3)return ENDINGS.advisor_kick;
  if(st.ending&&ENDINGS[st.ending])return ENDINGS[st.ending];
  return null;
}
function checkGoodEnding(st){
  if(st.ac>=16&&st.paperAccepted)return ENDINGS.academic_star;
  if(st.co>=16&&st.events_completed?.includes('national_contest'))return ENDINGS.national_award;
  if(st.ac>=10&&st.so>=10&&st.ph>=10&&st.co>=10&&st.ec>=10&&st.re>=10)return ENDINGS.hexagon;
  if(st.so>=12&&st.ec>=8)return ENDINGS.civil_servant;
  if(st.ec>=14&&st.so>=10)return ENDINGS.abroad;
  if(st.ec>=18)return ENDINGS.inherit;
  if(st.ac<8)return ENDINGS.delayed;
  return ENDINGS.graduate;
}
function randRange(a,b){return Math.floor(Math.random()*(b-a+1))+a;}
function clamp(v,mn,mx){return Math.max(mn,Math.min(mx,v));}

// ============================================================
// 引擎层
// ============================================================
function createNewState(diff){
  return{difficulty:diff,semester:0,money:Math.floor(5000*DIFFICULTIES[diff].moneyMult),
    ac:1,so:1,ph:1,co:1,ec:1,re:1,events_completed:[],fail_count:0,paperAccepted:false,
    ending:null,log:[],eventCards:[],lastActivityResult:null,bonusNextMult:1.0,totalSemesters:12};
}
let gameState=null;
function addLog(t){if(!gameState)return;gameState.log.push({semester:gameState.semester,text:t});}
function changeAttr(a,d){if(!gameState)return;gameState[a]=clamp((gameState[a]||0)+d,0,20);}
function applyEffects(ef,m){if(!ef)return;for(const[k,v] of Object.entries(ef))changeAttr(k,Math.round(v*(m||1)));}
function pushEventCard(t,d,tp){if(!gameState)return;gameState.eventCards.push({id:Date.now()+Math.random(),title:t,description:d,type:tp||'info'});}
function clearEventCards(){if(!gameState)return;gameState.eventCards=[];}

function settleEconomy(main){
  const st=gameState,exp=calcExpenses(st),inc=calcIncome(st,main),net=inc-exp;
  st.money+=net;
  addLog(`经济：收入¥${inc} 支出¥${exp} 净${net>=0?'+':''}¥${net} 余额¥${st.money}`);
  return{net,income:inc,expenses:exp};
}
function settleActivity(main,sub){
  const st=gameState,res=[];
  const ma=ACTIVITIES.find(a=>a.id===main);
  if(ma){const m=st.bonusNextMult;applyEffects(ma.effects,m);res.push({name:ma.name,effects:ma.effects});addLog(`主活动：${ma.name}`);st.bonusNextMult=1.0;}
  if(sub&&sub!=='none'){const sa=ACTIVITIES.find(a=>a.id===sub);if(sa){const se={};for(const[k,v] of Object.entries(sa.effects))se[k]=Math.ceil(v/2);applyEffects(se);res.push({name:sa.name+'（辅）',effects:se});addLog(`辅活动：${sa.name}`);}}
  return res;
}
function settleStageEvent(main){
  const st=gameState,ev=pickStageEvent(st,main);if(!ev)return null;
  const r=ev.resolve(st),emoji=r.success?'✅':'❌';
  pushEventCard(`${emoji} ${ev.name}`,r.desc,r.success?'success':'warning');
  applyEffects(r.effects);
  if(r.reward){st.money+=r.reward;addLog(`${ev.name}：奖金¥${r.reward}`);}
  if(r.paperAccepted)st.paperAccepted=true;
  addLog(`阶段事件：${ev.name} - ${r.success?'成功':'失败'}`);
  return{event:ev,result:r};
}
function settleRandomEvent(){
  const st=gameState,ev=rollRandomEvent(st);if(!ev)return null;
  if(ev.id==='ai_threat'){
    if(st.co>=10){pushEventCard(`🎲 ${ev.name}`,ev.desc+'（学到了新东西）','success');applyEffects(ev.effectsPositive);}
    else{pushEventCard(`🎲 ${ev.name}`,ev.desc+'（竞争力不够）','warning');applyEffects(ev.effectsNegative);}
    return{event:ev};
  }
  if(ev.type==='lethal'){pushEventCard(`💀 ${ev.name}`,ev.desc,'danger');st.ending=ev.ending;return{event:ev,lethal:true};}
  const tp=ev.type==='positive'?'success':'warning';
  pushEventCard(`🎲 ${ev.name}`,ev.desc,tp);applyEffects(ev.effects);
  if(ev.cost){st.money-=ev.cost;addLog(`${ev.name}：支出¥${ev.cost}`);}
  if(ev.reward){st.money+=ev.reward;addLog(`${ev.name}：获得¥${ev.reward}`);}
  if(ev.bonusNext){st.bonusNextMult=ev.bonusNext;addLog(`${ev.name}：下次活动×${ev.bonusNext}`);}
  return{event:ev};
}

function advanceSemester(mainAct,subAct){
  const st=gameState;if(!st||st.ending)return null;
  const phase=getPhase(st.semester),sn=SEMESTER_NAMES[st.semester];
  clearEventCards();addLog(`===== ${sn} =====`);
  if(st.difficulty===4){const av=getAvailableActivities(phase).filter(a=>canDoActivity(a,st));if(av.length){const r=av[Math.floor(Math.random()*av.length)];mainAct=r.id;pushEventCard('🎲 随机模式',`本学期：${r.name}`,'info');}}
  const ar=settleActivity(mainAct,subAct),er=settleEconomy(mainAct),sr=settleStageEvent(mainAct),rr=settleRandomEvent();
  const be=checkBadEnding(st);
  if(be)return{semester:st.semester,semesterName:sn,phase,activityResults:ar,economyResult:er,stageResult:sr,randomResult:rr,ending:be,gameOver:true};
  st.semester++;
  let ending=null,gameOver=false;
  if(st.semester>=st.totalSemesters){ending=checkGoodEnding(st);gameOver=true;st.ending=Object.keys(ENDINGS).find(k=>ENDINGS[k]===ending)||'graduate';}
  saveGame();
  return{semester:st.semester-1,semesterName:sn,phase,activityResults:ar,economyResult:er,stageResult:sr,randomResult:rr,ending,gameOver};
}

function saveGame(){if(!gameState)return;try{localStorage.setItem('grad-sim-save',JSON.stringify(gameState));}catch(e){}}
function loadGame(){try{const d=localStorage.getItem('grad-sim-save');if(d){gameState=JSON.parse(d);return true;}}catch(e){}return false;}
function deleteSave(){localStorage.removeItem('grad-sim-save');}
function hasSave(){return localStorage.getItem('grad-sim-save')!==null;}
function startNewGame(diff){gameState=createNewState(diff);clearEventCards();pushEventCard('🎓 新的开始','你拖着行李箱走进了大学校园，一切都那么新鲜。大一上学期开始了！','info');addLog('===== 游戏开始 =====');addLog(`难度：${DIFFICULTIES[diff].name}`);saveGame();return gameState;}
function continueGame(){if(loadGame())return gameState;return null;}
function getCurrentActivities(){if(!gameState)return[];const ph=getPhase(gameState.semester);return getAvailableActivities(ph).map(a=>({...a,available:canDoActivity(a,gameState),reqText:a.req?Object.entries(a.req).map(([k,v])=>{const n={ac:'学术',so:'社交',ph:'身体',co:'编程',ec:'经济',re:'心理'};return`${n[k]||k}≥${v}`;}).join(', '):null}));}
function getStateSummary(){if(!gameState)return null;return{...gameState,semesterName:SEMESTER_NAMES[gameState.semester],phase:getPhase(gameState.semester),progress:(gameState.semester/gameState.totalSemesters*100).toFixed(0)};}

