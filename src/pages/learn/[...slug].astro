---
import { getCollection } from "astro:content";
import Markdown from "../../components/misc/Markdown.astro";
import LearningLayout from "../../layouts/LearningLayout.astro";
import { getOperatorLessons, lessonUrl, type Lesson } from "../../utils/learning-utils";
export async function getStaticPaths() {
	return (await getCollection("learning")).map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
interface Props { entry: Lesson; }
const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const lessons = await getOperatorLessons();
const index = lessons.findIndex((lesson) => lesson.slug === entry.slug);
const previous = lessons[index - 1];
const next = lessons[index + 1];
---
<LearningLayout title={entry.data.title} description={entry.data.description} lessons={lessons} active={entry.slug} headings={headings}>
	<article class="learning-paper card-base text-90" data-pagefind-body>
		<header>
			<p class="learning-kicker">AI Infra / 算子 / {entry.data.module}</p>
			<h1 data-pagefind-meta="title">{entry.data.title}</h1>
			<p class="learning-description text-50">{entry.data.description}</p>
			<div class="learning-meta text-50" data-pagefind-ignore>
				<span>更新于 <time datetime={entry.data.updated.toISOString()}>{entry.data.updated.toISOString().slice(0, 10)}</time></span>
				{entry.data.prerequisites.length > 0 && <span>先修：{entry.data.prerequisites.join("、")}</span>}
			</div>
		</header>
		<Markdown class="learning-content onload-animation"><Content /></Markdown>
	</article>
	<nav class="learning-pagination text-75" aria-label="上一篇与下一篇" data-pagefind-ignore>
		{previous ? <a href={lessonUrl(previous)} rel="prev"><small>← 上一篇</small><strong>{previous.data.title}</strong></a> : <span />}
		{next && <a href={lessonUrl(next)} rel="next"><small>下一篇 →</small><strong>{next.data.title}</strong></a>}
	</nav>
</LearningLayout>
