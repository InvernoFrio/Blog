---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="百宝箱">
<div class="prose dark:prose-invert max-w-none">
<h1>🧰 百宝箱</h1>

<p>一些常用的工具和资源收藏。</p>

<h2>开发工具</h2>

<table>
<thead><tr><th>工具</th><th>链接</th><th>说明</th></tr></thead>
<tbody>
<tr><td>VS Code</td><td><a href="https://code.visualstudio.com/" target="_blank">code.visualstudio.com</a></td><td>代码编辑器</td></tr>
<tr><td>GitHub</td><td><a href="https://github.com/" target="_blank">github.com</a></td><td>代码托管平台</td></tr>
<tr><td>Docker</td><td><a href="https://www.docker.com/" target="_blank">docker.com</a></td><td>容器化平台</td></tr>
</tbody>
</table>

<h2>学习资源</h2>

<table>
<thead><tr><th>资源</th><th>链接</th><th>说明</th></tr></thead>
<tbody>
<tr><td>MDN Web Docs</td><td><a href="https://developer.mozilla.org/" target="_blank">developer.mozilla.org</a></td><td>Web 开发文档</td></tr>
<tr><td>Stack Overflow</td><td><a href="https://stackoverflow.com/" target="_blank">stackoverflow.com</a></td><td>技术问答社区</td></tr>
<tr><td>arXiv</td><td><a href="https://arxiv.org/" target="_blank">arxiv.org</a></td><td>学术论文预印本</td></tr>
</tbody>
</table>

<h2>在线工具</h2>

<table>
<thead><tr><th>工具</th><th>链接</th><th>说明</th></tr></thead>
<tbody>
<tr><td>TinyPNG</td><td><a href="https://tinypng.com/" target="_blank">tinypng.com</a></td><td>图片压缩</td></tr>
<tr><td>Carbon</td><td><a href="https://carbon.now.sh/" target="_blank">carbon.now.sh</a></td><td>代码截图</td></tr>
<tr><td>Excalidraw</td><td><a href="https://excalidraw.com/" target="_blank">excalidraw.com</a></td><td>手绘风格画图</td></tr>
</tbody>
</table>

