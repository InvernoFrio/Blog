---

import MainGridLayout from "../layouts/MainGridLayout.astro";
---
<MainGridLayout title="小满状态" description="AI助手小满的实时运行状态">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">

            <h1 class="text-2xl font-bold mb-2">📊 小满状态</h1>
            <p class="text-sm text-black/50 dark:text-white/50 mb-6">AI 助手小满的实时运行状态</p>

            <!-- 状态卡片 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <!-- 在线状态 -->
                <div class="rounded-xl border border-black/10 dark:border-white/10 p-5">
                    <div class="flex items-center gap-3 mb-3">
                        <span id="agentStatusDot" class="w-3 h-3 rounded-full bg-gray-400"></span>
                        <span class="text-lg font-semibold" id="agentStatus">检测中...</span>
                    </div>
                    <div class="text-sm text-black/50 dark:text-white/50">
                        <div>运行时间：<span id="agentUptime">-</span></div>
                    </div>
                </div>

                <!-- 系统状态 -->
                <div class="rounded-xl border border-black/10 dark:border-white/10 p-5">
                    <div class="text-lg font-semibold mb-3">🖥️ 服务器</div>
                    <div class="text-sm text-black/50 dark:text-white/50 space-y-1">
                        <div>运行时间：<span id="sysUptime">-</span></div>
                        <div>系统负载：<span id="sysLoad">-</span></div>
                        <div>内存使用：<span id="sysMem">-</span></div>
                    </div>
                </div>

                <!-- Cron 任务 -->
                <div class="rounded-xl border border-black/10 dark:border-white/10 p-5">
                    <div class="text-lg font-semibold mb-3">⏰ 定时任务</div>
                    <div class="text-sm text-black/50 dark:text-white/50">
                        <div>活跃任务：<span id="cronActive">-</span></div>
                    </div>
                </div>

                <!-- 版本信息 -->
                <div class="rounded-xl border border-black/10 dark:border-white/10 p-5">
                    <div class="text-lg font-semibold mb-3">🔧 版本</div>
                    <div class="text-sm text-black/50 dark:text-white/50">
                        <div>OpenClaw：<span id="version">-</span></div>
                        <div>更新时间：<span id="lastUpdate">-</span></div>
                    </div>
                </div>
            </div>

            <div id="errorMsg" class="hidden text-center text-sm text-red-500 py-4"></div>

            <p class="text-xs text-black/30 dark:text-white/30">状态每 60 秒自动刷新 · 数据来源：OpenClaw Gateway</p>
        </div>
    </div>

    <script>
        const API_BASE = "http://REDACTED_IP";

        function formatUptime(sec) {
            if (!sec || sec <= 0) return "-";
            const d = Math.floor(sec / 86400);
            const h = Math.floor((sec % 86400) / 3600);
            const m = Math.floor((sec % 3600) / 60);
            if (d > 0) return `${d}天${h}小时${m}分钟`;
            if (h > 0) return `${h}小时${m}分钟`;
            return `${m}分钟`;
        }

        async function fetchStatus() {
            const errorEl = document.getElementById("errorMsg");
            try {
                const resp = await fetch(`${API_BASE}/api/status`);
                if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
                const data = await resp.json();

                errorEl.classList.add("hidden");

                // Agent 状态
                const dot = document.getElementById("agentStatusDot");
                const statusEl = document.getElementById("agentStatus");
                if (data.agent?.status === "online") {
                    dot.className = "w-3 h-3 rounded-full bg-green-500";
                    statusEl.textContent = `${data.agent.emoji || "🌾"} ${data.agent.name || "小满"} 在线`;
                } else {
                    dot.className = "w-3 h-3 rounded-full bg-red-500";
                    statusEl.textContent = `${data.agent?.name || "小满"} 离线`;
                }
                document.getElementById("agentUptime").textContent = formatUptime(data.agent?.uptimeSeconds);

                // 系统状态
                document.getElementById("sysUptime").textContent = formatUptime(data.system?.uptimeSeconds);
                document.getElementById("sysLoad").textContent = data.system?.load ?? "-";
                document.getElementById("sysMem").textContent = data.system?.memoryPercent ? `${data.system.memoryPercent}%` : "-";

                // Cron
                document.getElementById("cronActive").textContent = data.cron?.active ?? "-";

                // 版本
                document.getElementById("version").textContent = data.version ?? "-";
                document.getElementById("lastUpdate").textContent = data.timestamp
                    ? new Date(data.timestamp).toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" })
                    : "-";

            } catch (err) {
                errorEl.textContent = `无法获取状态：${err.message}`;
                errorEl.classList.remove("hidden");
            }
        }

        fetchStatus();
        setInterval(fetchStatus, 60000);
    </script>
</MainGridLayout>
