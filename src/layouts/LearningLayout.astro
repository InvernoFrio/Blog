---
import type { MarkdownHeading } from "astro";
import Navigation from "../components/learning/Navigation.astro";
import Outline from "../components/learning/Outline.astro";
import SideBar from "../components/widget/SideBar.astro";
import { siteConfig } from "../config";
import type { Lesson } from "../utils/learning-utils";
import { url } from "../utils/url-utils";
import MainGridLayout from "./MainGridLayout.astro";
import "../styles/learning.css";

interface Props {
	title: string;
	description: string;
	lessons?: Lesson[];
	active?: string;
	headings?: MarkdownHeading[];
}
const { title, description, lessons = [], active, headings = [] } = Astro.props;
const isCoursePage = Astro.url.pathname.startsWith(url("/learn/ai-infra/"));
---
<MainGridLayout title={title} description={description} headings={headings} learningPage setOGTypeArticle={!!active}>
	<Fragment slot="sidebar">
		{lessons.length > 0 ? (
			<aside id="sidebar" class="learning-sidebar col-span-2 lg:col-span-1 onload-animation">
				<div class="learning-sidebar-sticky">
					<Navigation lessons={lessons} active={active} />
				</div>
			</aside>
		) : (
			<SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" />
		)}
	</Fragment>
	<a class="learning-skip" href="#learning-article">跳到正文</a>
	<div class="learning-center">
		<nav class="learning-breadcrumb card-base text-50" aria-label="当前位置" data-pagefind-ignore>
			<a class="link" href={url("/learn/")} aria-current={!isCoursePage ? "page" : undefined}>学习</a>
			{isCoursePage && <><span aria-hidden="true">/</span><a class="link" href={url("/learn/ai-infra/")} aria-current={!active ? "page" : undefined}>AI Infra</a></>}
			{active && <><span aria-hidden="true">/</span><span>算子</span></>}
		</nav>
		{headings.length > 0 && <div class:list={["learning-inline-outline", { "2xl:hidden": siteConfig.toc.enable }]}><Outline headings={headings} /></div>}
		<div id="learning-article" tabindex="-1"><slot /></div>
	</div>
</MainGridLayout>
